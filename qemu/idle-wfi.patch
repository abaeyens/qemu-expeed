 /*
+ * z6ii: EMU_IDLE_WFI. The camera's idle loop busy-spins, and under
+ * icount the vCPUs share one instruction budget, so an idle core takes half
+ * of it. With the knob, target/arm halts a core in that loop as a WFI would
+ * (emu_idle_wfi_mark), and while it is halted the cores that run are
+ * charged for it: each slice's instructions advance the virtual clock by
+ * (running + idle-halted) / running times as much, and its budget shrinks to
+ * match. Every core then still runs at the rate it had when the idle core
+ * spun (one instruction per 2^shift ns per running-or-spinning core), and
+ * when all of them idle the clock skips to the next timer. A core halted by
+ * an ordinary WFI is not charged for, as before.
+ */
+#define EMU_IDLE_MAX_CPUS 64
+bool emu_idle_enabled(void);
+int64_t emu_idle_slice_budget(CPUState *cpu, int64_t budget);
+static bool emu_idle_halted[EMU_IDLE_MAX_CPUS];
+static int64_t emu_idle_num[EMU_IDLE_MAX_CPUS], emu_idle_den[EMU_IDLE_MAX_CPUS];
+static int64_t emu_idle_rem[EMU_IDLE_MAX_CPUS];
+
+bool emu_idle_enabled(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("EMU_IDLE_WFI");
+        on = e && *e && strcmp(e, "0") != 0;
+    }
+    return on;
+}
+
+void emu_idle_wfi_mark(CPUState *cpu, bool idle);
+void emu_idle_wfi_mark(CPUState *cpu, bool idle)
+{
+    int i = cpu->cpu_index;
+
+    if (i >= EMU_IDLE_MAX_CPUS) {
+        return;
+    }
+    emu_idle_halted[i] = idle;
+}
+
+/* The slice's charge factor, and its budget in this vCPU's instructions. */
+int64_t emu_idle_slice_budget(CPUState *cpu, int64_t budget)
+{
+    CPUState *c;
+    int64_t running = 0, idle = 0;
+    int i = cpu->cpu_index;
+
+    if (!emu_idle_enabled() || i >= EMU_IDLE_MAX_CPUS) {
+        return budget;
+    }
+    CPU_FOREACH(c) {
+        if (!c->halted) {
+            running++;
+        } else if (c->cpu_index < EMU_IDLE_MAX_CPUS &&
+                   emu_idle_halted[c->cpu_index]) {
+            idle++;
+        }
+    }
+    if (running == 0) {
+        running = 1;
+    }
+    emu_idle_num[i] = running + idle;
+    emu_idle_den[i] = running;
+    /* at least one instruction: a zero budget runs nothing and the clock never gets there */
+    return budget > 0 ? MAX(budget * running / (running + idle), 1) : budget;
+}
+
+/* Instructions of this vCPU -> instructions of virtual time. */
+static int64_t emu_idle_charge(CPUState *cpu, int64_t executed)
+{
+    int i = cpu->cpu_index;
+    int64_t n;
+
+    if (!emu_idle_enabled() || i >= EMU_IDLE_MAX_CPUS ||
+        emu_idle_den[i] == 0 || emu_idle_num[i] == emu_idle_den[i]) {
+        return executed;
+    }
+    n = executed * emu_idle_num[i] + emu_idle_rem[i];
+    emu_idle_rem[i] = n % emu_idle_den[i];
+    return n / emu_idle_den[i];
+}
+
+/*
  * The current number of executed instructions is based on what we
  * originally budgeted minus the current state of the decrementing
  * icount counters in extra/u16.low.
@@ -86,7 +169,7 @@
     cpu->icount_budget -= executed;
 
     qatomic_set_i64(&timers_state.qemu_icount,
-                    timers_state.qemu_icount + executed);
+                    timers_state.qemu_icount + emu_idle_charge(cpu, executed));
 }
 
