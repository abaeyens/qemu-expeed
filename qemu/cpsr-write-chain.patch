+/*
+ * z6ii: an MSR to the CPSR ends its TB with an exit to the main loop, so
+ * that an interrupt it unmasks is taken. When it changes no mode and unmasks
+ * nothing while an interrupt is pending (the camera's idle loop, twice per
+ * iteration), link to the next TB instead; an interrupt raised meanwhile still
+ * stops the next TB at its start. A32, unconditional, not single-stepping
+ * only. EMU_CPSR_CHAIN=0 turns it off.
+ */
+static bool emu_cpsr_chain_enabled(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *e = getenv("EMU_CPSR_CHAIN");
+        on = !(e && !strcmp(e, "0"));
+    }
+    return on;
+}
