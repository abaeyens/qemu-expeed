+/*
+ * z6ii: an MSR to the CPSR that the translator may chain past (see
+ * gen_set_psr): returns non-zero when the caller must go back to the main
+ * loop -- the mode, E, IL or PAN changed, or an A/I/F mask went from masked
+ * to unmasked while an interrupt is pending (one raised while masked: the
+ * main loop saw it masked and left it pending; one raised later stops the
+ * next TB at its start by itself).
+ */
+uint32_t HELPER(emu_cpsr_write)(CPUARMState *env, uint32_t val, uint32_t mask)
+{
+    uint32_t old_cpsr = env->uncached_cpsr;
+    uint64_t old_daif = env->daif;
+    CPUState *cs = env_cpu(env);
+
+    if (!(mask & ~(CPSR_M | CPSR_AIF)) &&
+        !((val ^ old_cpsr) & mask & CPSR_M) &&
+        !((old_daif ^ val) & mask & (CPSR_A | CPSR_F))) {
+        /*
+         * Only the I mask can change, in the same mode (an `msr cpsr_c`
+         * toggling IRQs): all cpsr_write() would do is set it in env->daif
+         * -- no mode switch, no SCR.AW/FW or NMFI check (they need A or F
+         * to change), and no hflags rebuild (M, E, IL, PAN are unchanged).
+         */
+        env->daif = (old_daif & ~(CPSR_I & mask)) | (val & CPSR_I & mask);
+    } else {
+        HELPER(cpsr_write)(env, val, mask);
+    }
+    if ((old_cpsr ^ env->uncached_cpsr) & (CPSR_M | CPSR_E | CPSR_IL | CPSR_PAN)) {
+        return 1;
+    }
+    return (old_daif & ~env->daif & (CPSR_A | CPSR_I | CPSR_F)) != 0 &&
+           (qatomic_read(&cs->interrupt_request) &
+            (CPU_INTERRUPT_HARD | CPU_INTERRUPT_FIQ | CPU_INTERRUPT_VIRQ |
+             CPU_INTERRUPT_VFIQ | CPU_INTERRUPT_VSERR | CPU_INTERRUPT_EXITTB)) != 0;
+}
