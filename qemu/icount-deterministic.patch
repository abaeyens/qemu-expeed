+/*
+ * Under icount the stock loop gives each vCPU limit/cpu_count instructions per pass, where limit is
+ * the distance to the next timer deadline, so WHERE one vCPU hands over to the next depends on which
+ * timers happen to be armed: an extra timer (a guest-time pause, a debugger stop) changes the
+ * interleaving and with it the run. Here a vCPU hands over only after a fixed quantum of its own
+ * instructions (or when it halts or yields); a deadline or a stop merely interrupts it, and it then
+ * finishes its quantum. QEMU_ICOUNT_RR_QUANTUM=<n> turns this on (default 0 = the stock slicing: with a
+ * 20000-instruction quantum the machine got less far in the same virtual time, most
+ * likely cores spinning a whole quantum on a lock the other holds).
+ */
+static int64_t rr_quantum = -1;
+static int64_t rr_quantum_left;
+
+static int64_t rr_quantum_get(void)
+{
+    if (rr_quantum < 0) {
+        const char *q = getenv("QEMU_ICOUNT_RR_QUANTUM");
+        rr_quantum = q ? strtoll(q, NULL, 0) : 0;
+    }
+    return rr_quantum;
+}
