Optionally make the camera's kernel spinlock yield its vCPU's turn (EMU_SPIN_YIELD)

diff -ru a/target/arm/tcg/translate.c b/target/arm/tcg/translate.c
--- a/target/arm/tcg/translate.c
+++ b/target/arm/tcg/translate.c
@@ -7807,6 +7807,66 @@
     }
